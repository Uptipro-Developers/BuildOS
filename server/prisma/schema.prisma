  code          String?        @unique
  periodId      String?
  period        PayrollPeriod? @relation(fields: [periodId], references: [id])
  periodName    String
  month         Int
  year          Int
  /// HR side: "Draft" | "Processing" | "Approved". Finance side then carries it
  /// through "Pending Posting Approval" → "Posting Approved" → "Posted".
  /// Approval to post is deliberately separate from posting: the person who
  /// authorises the accounting is not always the one who runs it.
  status        String         @default("Draft")
  totalGross    Float          @default(0)
  totalNet      Float          @default(0)
  employeeCount Int            @default(0)
  processedBy   String?
  processedAt   DateTime?

  // Finance posting trail.
  postingRequestedBy String?
  postingRequestedAt DateTime?
  postingApprovedBy  String?
  postingApprovedAt  DateTime?
  postedBy           String?
  postedAt           DateTime?
  /// The journal entry this run posted as, so the Overview can cite it and the
  /// General Ledger can be traced back to the run.
  journalEntryId     String?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

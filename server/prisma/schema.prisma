// ─────────────── NOTIFICATIONS ───────────────

model Notification {
  id          String             @id @default(cuid())
  userId      String
  title       String
  message     String
  type        String // "approval", "task", "alert", "info"
  status      NotificationStatus @default(sent)
  actionUrl   String?
  relatedId   String? // ID of related entity
  relatedType String? // Type of related entity
  readAt      DateTime?
  sentAt      DateTime           @default(now())
  createdAt   DateTime           @default(now())
}

model NotificationRule {
  id          String   @id @default(cuid())
  event       String // Event type: "leave_approved", "payroll_processed", etc.
  description String
  conditions  Json? // Stored as JSON array of condition objects
  actions     String[] // ["email", "push", "sms"]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Webhook {
  id         String            @id @default(cuid())
  url        String
  event      String // Event to trigger on: "*" for all or specific events
  isActive   Boolean           @default(true)
  secret     String // HMAC secret for webhook verification
  headers    Json? // Custom headers JSON
  maxRetries Int               @default(5)
  retryCount Int               @default(0)
  lastError  String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id           String    @id @default(cuid())
  webhookId    String
  webhook      Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  payload      Json
  status       String // "pending", "delivered", "failed"
  responseCode Int?
  responseBody String?
  error        String?
  attemptCount Int       @default(0)
  nextRetry    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─────────────── WORKFLOW & APPROVAL MODELS ───────────────

model WorkflowInstance {
  id               String            @id @default(cuid())
  workflowId       String
  approvalWorkflow ApprovalWorkflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  entityType       String // "expense", "leave", "purchase_order", etc.
  entityId         String // ID of the related entity
  status           String            @default("in_progress") // "in_progress", "completed", "rejected"
  initiatedBy      String

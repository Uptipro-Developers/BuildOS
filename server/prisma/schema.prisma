generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id               String        @id @default(cuid())
  name             String
  client           String
  location         String
  state            String
  city             String
  status           ProjectStatus @default(Planning)
  type             ProjectType
  budget           Float
  spent            Float         @default(0)
  progress         Int           @default(0)
  startDate        DateTime
  endDate          DateTime
  manager          String
  teamSize         Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  actualEndDate    DateTime?
  approvalStatus   String        @default("pending")
  contingency      Float?        @default(0)
  stakeholders     String[]      @default([])
  siteAddress      String?
  mainContractor   String?
  mainContractorId String?
  contractType     String?
  clusterId        String?
  ragStatus        String?       @default("on-track")
  description      String?
  descriptor       String?
  sector           String?
  category         String?
  blockCount       Int?
  contractingModel String?
  lastReportDate   DateTime?
  setupComplete    Boolean?      @default(false)
  setupProgress    Int?          @default(0)
  setupLocked      Boolean?      @default(false)
  budgets          Budget[]
  expenses         Expense[]
  incomes          Income[]
}

model Department {
  id              String     @id @default(cuid())
  name            String     @unique
  description     String
  location        String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  headId          String?    @unique
  budgetEndDate   DateTime?
  budgetStartDate DateTime?
  budget          Float      @default(0)
  head            Employee?  @relation("DeptHead", fields: [headId], references: [id])
  employees       Employee[] @relation("DeptMembers")
}

model Employee {
  id                String         @id @default(cuid())
  firstName         String
  lastName          String
  email             String         @unique
  phone             String
  dateHired         DateTime
  status            EmployeeStatus @default(active)
  employmentType    EmploymentType @default(FullTime)
  projectCount      Int            @default(0)
  projects          String[]       @default([])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  departmentId      String?
  accountHolder     String?
  accountNumber     String?
  address           String?
  bankName          String?
  baseSalary        Float?         @default(0)
  city              String?
  dateOfBirth       DateTime?
  emergencyContact  String?
  emergencyPhone    String?
  gender            String?
  gradeLevel        String?
  healthInsuranceId String?
  jobRoleId         String?
  middleName        String?
  pensionId         String?
  state             String?
  supervisorId      String?
  taxId             String?
  zipCode           String?
  role              String?
  userId            String?        @unique
  /// Captured by the Add/Edit Employee form in the design. These had no columns,
  /// so the values were collected and silently dropped on save.
  maritalStatus     String?
  nationality       String?
  orgUnit           String?
  claims            Claim[]
  headOf            Department?    @relation("DeptHead")
  department        Department?    @relation("DeptMembers", fields: [departmentId], references: [id])
  jobRole           JobRole?       @relation("EmployeeJobRole", fields: [jobRoleId], references: [id])
  supervisor        Employee?      @relation("SupervisorOf", fields: [supervisorId], references: [id])
  subordinates      Employee[]     @relation("SupervisorOf")
  user              User?          @relation(fields: [userId], references: [id])
  leaveRequests     LeaveRequest[]
}

model LeaveType {
  id                String         @id @default(cuid())
  name              String         @unique
  daysAllowed       Int
  carryOver         Boolean        @default(false)
  maxCarryOver      Int            @default(0)
  paid              Boolean        @default(true)
  approvalsRequired Int            @default(1)
  color             String
  gender            String         @default("All")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  leaveRequests     LeaveRequest[]
}

model LeaveRequest {
  id            String      @id @default(cuid())
  refId         String      @unique
  days          Int
  startDate     DateTime
  endDate       DateTime
  status        LeaveStatus @default(pending)
  submittedAt   DateTime    @default(now())
  approvedBy    String?
  approvedAt    DateTime?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  employeeId    String
  leaveTypeId   String
  autoApproved  Boolean?    @default(false)
  balanceAfter  Int?
  balanceBefore Int?
  employee      Employee    @relation(fields: [employeeId], references: [id])
  leaveType     LeaveType   @relation(fields: [leaveTypeId], references: [id])
}

model ClaimType {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String
  isProjectBased Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  claims         Claim[]
}

model Claim {
  id              String      @id @default(cuid())
  amount          Float
  description     String
  date            DateTime
  status          ClaimStatus @default(Submitted)
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  paidAt          DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  employeeId      String
  claimTypeId     String
  claimType       ClaimType   @relation(fields: [claimTypeId], references: [id])
  employee        Employee    @relation(fields: [employeeId], references: [id])
}

model Supplier {
  id                 String             @id @default(cuid())
  name               String
  contactPerson      String
  phone              String
  email              String
  city               String
  categories         String[]
  rating             Float              @default(0)
  onTimeDeliveryRate Float              @default(0)
  rejectRate         Float              @default(0)
  totalSpend         Float              @default(0)
  lastOrder          DateTime?
  status             String             @default("active")
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  /// Identity bridge to the SabiQuot supplier portal. Holds the SabiQuot
  /// `profiles.id` (a uuid) for suppliers that exist on both sides, so an RFQ
  /// can be routed to the right portal account and a portal signup can be
  /// reconciled against an existing supplier instead of duplicating it.
  sabiquotProfileId  String?            @unique
  /// Where this supplier record originated: "buildos" for records created in
  /// the ERP, "sabiquot" for portal self-registrations.
  source             String             @default("buildos")
  purchaseOrders     PurchaseOrder[]
  materials          SupplierMaterial[]
}

model SupplierMaterial {
  id         String   @id @default(cuid())
  name       String
  unit       String
  lastPrice  Float
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id               String         @id @default(cuid())
  prRef            String?
  mrRef            String?
  status           POStatus       @default(draft)
  sentToFinance    Boolean        @default(false)
  /// Invoice number of the PurchaseInvoice raised in Finance when this order was
  /// sent there. The link is what lets a payment recorded in Finance show up on
  /// the order in Procurement.
  financeRef       String?
  createdBy        String
  createdDate      DateTime       @default(now())
  expectedDate     DateTime
  totalValue       Float          @default(0)
  receivedValue    Float          @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  supplierId       String
  /// The ReceivedQuote that was awarded, when this order came out of a quote
  /// comparison. This is the record of *which* supplier won and at what price,
  /// and there was previously nowhere to put it — so an award could not be
  /// represented even though the UI offered the button.
  quoteRef         String?
  /// The order's own human reference (PO-0007), from the PurchaseOrder sequence
  /// in Settings › Numbering. The award screen allocated one and then threw it
  /// away because there was no column for it, so every screen fell back to
  /// showing the cuid under a heading that said "PO ID" — and a goods receipt
  /// could not cite the order it was receiving against.
  poRef            String?        @unique
  /// Milestones of the payment chain, so the order can say *when* each step
  /// happened rather than only which step it is on.
  sentToFinanceAt  DateTime?
  financeDecidedAt DateTime?
  paidAt           DateTime?
  confirmedAt      DateTime?
  /// Why Finance declined, shown back on the order in Procurement so the buyer
  /// knows what to fix.
  declineReason    String?
  goodsReceipts    GoodsReceipt[]
  items            POItem[]
  supplier         Supplier       @relation(fields: [supplierId], references: [id])
}

model POItem {
  id              String        @id @default(cuid())
  material        String
  qty             Float
  unit            String
  unitCost        Float
  received        Float         @default(0)
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

/// A delivery received against a purchase order.
///
/// Goods Receipt was previously a screen with no storage behind it at all: the
/// list started empty on every load, "Accept & Update Stock" flipped a flag in
/// React state, and nothing reached stock, materials or the storefront. This is
/// the record that closes the chain — receiving one updates StockMovement,
/// StoreItem and Material, and moves the order to `goods_received`.
model GoodsReceipt {
  id              String             @id @default(cuid())
  reference       String             @unique
  purchaseOrderId String
  /// Denormalised so a receipt still reads correctly in lists and exports
  /// without joining the order.
  poRef           String?
  mrRef           String?
  supplierName    String
  /// Where the goods landed. Stock is posted against this store.
  storeId         String?
  storeName       String
  deliveryNote    String?
  receivedBy      String
  receivedDate    DateTime           @default(now())
  status          String             @default("pending")
  notes           String?
  /// Set when the receipt is accepted and stock has been posted. Guards the
  /// posting so a double-click cannot add the same delivery to stock twice.
  stockPostedAt   DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  items           GoodsReceiptItem[]

  @@index([purchaseOrderId])
}

model GoodsReceiptItem {
  id             String       @id @default(cuid())
  material       String
  unit           String
  ordered        Float        @default(0)
  received       Float        @default(0)
  accepted       Float        @default(0)
  rejected       Float        @default(0)
  reason         String?
  goodsReceiptId String
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
}

model Expense {
  id              String        @id @default(cuid())
  category        String
  amount          Float
  description     String
  createdBy       String
  date            DateTime
  status          ExpenseStatus @default(Draft)
  receipt         String?
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  projectId       String?
  project         Project?      @relation(fields: [projectId], references: [id])
}

model Income {
  id          String       @id @default(cuid())
  source      String
  amount      Float
  description String
  date        DateTime
  status      IncomeStatus @default(Draft)
  receivedBy  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id])
}

model Budget {
  id          String       @id @default(cuid())
  name        String
  scope       BudgetScope  @default(Project)
  totalBudget Float
  spent       Float        @default(0)
  committed   Float        @default(0)
  period      String
  status      BudgetStatus @default(Active)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id])
}

model Payment {
  id          String        @id @default(cuid())
  type        PaymentType
  reference   String
  recipient   String
  amount      Float
  method      String
  bank        String?
  date        DateTime
  status      PaymentStatus @default(ApprovedRequest)
  initiatedBy String?
  completedAt DateTime?
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model User {
  id                    String                @id @default(cuid())
  email                 String                @unique
  password              String
  name                  String
  department            String?
  phone                 String?
  status                String                @default("Active")
  lastLogin             DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  refreshTokenHash      String?
  refreshTokenExpiresAt DateTime?
  assignedApps          String[]              @default(["ess"])
  userId                String?               @unique
  signature             String?
  inviteExpiresAt       DateTime?
  inviteToken           String?
  permissionScope       String                @default("global")
  role                  String                @default("viewer")
  permissionOverrides   String[]              @default([])
  /// Last time an authenticated request was seen from this user, refreshed as
  /// they use the app rather than only at login. `lastLogin` cannot answer "who
  /// is logged in now" — somebody who signed in this morning and left still
  /// counts against it all day.
  lastSeenAt            DateTime?
  auditLogs             AuditLog[]
  employee              Employee?
  Signatory             Signatory?
  roles                 UserRole[]
  passwordHistory       UserPasswordHistory[]
  permissions           Permission[]          @relation("PermissionToUser")

  @@index([lastSeenAt])
}

model UserRole {
  id         String    @id @default(cuid())
  userId     String
  roleId     String
  validFrom  DateTime  @default(now())
  validUntil DateTime?
  grantedBy  String?
  createdAt  DateTime  @default(now())
  role       AppRole   @relation(fields: [roleId], references: [id])
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Permission {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  appScope    String
  createdAt   DateTime  @default(now())
  appRoles    AppRole[] @relation("AppRoleToPermission")
  users       User[]    @relation("PermissionToUser")
}

model AppRole {
  id             String       @id @default(cuid())
  name           String       @unique
  description    String?
  isSuper        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  appScope       String[]     @default([])
  inheritedRoles String[]     @default([])
  users          UserRole[]
  permissions    Permission[] @relation("AppRoleToPermission")
}

model CompanyProfile {
  id        String   @id @default("singleton")
  name      String   @default("")
  email     String   @default("")
  phone     String   @default("")
  address   String   @default("")
  city      String   @default("")
  state     String   @default("")
  zipCode   String   @default("")
  country   String   @default("")
  logoUrl   String?
  updatedAt DateTime @updatedAt
}

model Director {
  id          String   @id @default(cuid())
  firstName   String
  middleName  String   @default("")
  lastName    String
  designation String
  sequence    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Material {
  id               String   @id @default(cuid())
  name             String
  category         String
  unit             String
  totalQty         Float    @default(0)
  availableQty     Float    @default(0)
  reservedQty      Float    @default(0)
  unitCost         Float    @default(0)
  reorderLevel     Float    @default(0)
  materialType     String   @default("Consumable")
  allocationStatus String   @default("Available")
  allocatedTo      String?
  allocatedProject String?
  condition        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Store {
  id          String      @id @default(cuid())
  name        String
  type        String      @default("General")
  projectId   String?
  projectName String?
  manager     String?
  location    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  storeItems  StoreItem[]
}

model StoreItem {
  id           String    @id @default(cuid())
  materialName String
  category     String
  unit         String
  qty          Float     @default(0)
  reorderLevel Float     @default(0)
  unitCost     Float     @default(0)
  lastReceived DateTime?
  bin          String?
  storeId      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model StockMovement {
  id           String   @id @default(cuid())
  type         String
  materialName String
  unit         String
  qty          Float
  storeName    String
  storeId      String?
  reference    String?
  projectName  String?
  projectId    String?
  date         DateTime @default(now())
  createdBy    String
  notes        String?
  createdAt    DateTime @default(now())
}

model StockTransfer {
  id            String    @id @default(cuid())
  reference     String    @unique
  fromStoreId   String?
  fromStoreName String
  toStoreId     String?
  toStoreName   String
  items         Json      @default("[]")
  status        String    @default("Pending")
  requestedBy   String
  approvedBy    String?
  requestDate   DateTime  @default(now())
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model MaterialRequest {
  id           String    @id @default(cuid())
  reference    String    @unique
  materialName String
  unit         String
  qty          Float
  storeName    String
  storeId      String?
  projectName  String?
  projectId    String?
  purpose      String?
  priority     String    @default("Normal")
  status       String    @default("Pending")
  requestedBy  String
  approvedBy   String?
  requestDate  DateTime  @default(now())
  approvedAt   DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// When the materials are needed, derived from the requester's "Needed In
  /// (days)". Without a column the computed date existed only in the browser, so
  /// the card showed a blank Due date as soon as the list reloaded.
  neededBy     DateTime?
  /// Reference of the PurchaseRequest raised from this request, so the material
  /// request can show what became of it instead of stopping at "In Procurement".
  prRef        String?
}

model MaterialReturn {
  id            String    @id @default(cuid())
  reference     String    @unique
  materialName  String
  unit          String
  qty           Float
  fromStoreName String
  toStoreName   String
  condition     String    @default("Good")
  reason        String?
  status        String    @default("Pending")
  requestedBy   String
  approvedBy    String?
  requestDate   DateTime  @default(now())
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model PurchaseRequest {
  id              String   @id @default(cuid())
  prRef           String   @unique
  title           String
  projectId       String?
  projectName     String?
  /// "draft" | "not_raised" | "raised" | "quotes_received" | "po_created" |
  /// "cancelled". A purchase request carries no approval status of its own —
  /// see the POStatus comment and src/app/utils/procurementWorkflow.tsx.
  status          String   @default("not_raised")
  priority        String   @default("Normal")
  requestedBy     String
  daysToDeliver   Int?
  items           Json     @default("[]")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  /// Reference of the MaterialRequest this was raised from, when it came through
  /// Procurement › Material Requests rather than being raised standalone. The
  /// link previously existed only inside the `notes` prose ("Raised from Material
  /// Request MR-0007"), which nothing could query or follow.
  mrRef           String?
  /// How this request is being sourced: "rfq" to compete it across suppliers, or
  /// "direct" for a single named supplier. Chosen when the request is raised and
  /// it decides whether RFQs are sent, so it has to survive the round trip.
  procurementType String   @default("rfq")
  /// Per-supplier progress: `{ supplier, supplierId?, status, sentDate?,
  /// quoteRef?, quoteAmount?, poRef? }`. Held as JSON rather than a table because
  /// it is only ever read back with the request it belongs to.
  suppliers       Json     @default("[]")
}

model PurchaseInvoice {
  id           String    @id @default(cuid())
  invoiceNo    String    @unique
  poRef        String?
  supplierName String
  supplierId   String?
  invoiceDate  DateTime
  dueDate      DateTime?
  lines        Json      @default("[]")
  subtotal     Float     @default(0)
  vatTotal     Float     @default(0)
  total        Float     @default(0)
  /// "pending_review" | "accepted" | "declined" | "paid" | "cancelled".
  status       String    @default("pending_review")
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model SentRFQ {
  id           String    @id @default(cuid())
  rfqRef       String    @unique
  supplierName String
  supplierId   String?
  status       String    @default("Sent")
  items        Json      @default("[]")
  sentDate     DateTime  @default(now())
  expiryDate   DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// The PurchaseRequest this RFQ was competed for. One row is one supplier, so
  /// an RFQ sent to five suppliers is five rows sharing a prRef — this is what
  /// groups them back into a single sourcing event for quote comparison. The UI
  /// collected it before and the server dropped it on the floor.
  prRef        String?
  /// Where this RFQ was actually sent, when it differs from the supplier's
  /// filed address — a project-specific sales contact, say. Defaults to the
  /// supplier's email in the form. Stored so the list shows the address that was
  /// used and a resend goes back to the same person.
  contactEmail String?

  @@index([prRef])
}

model ReceivedQuote {
  id               String    @id @default(cuid())
  rfqRef           String?
  supplierName     String
  supplierId       String?
  /// "pending_review" | "approved" | "rejected" | "po_created".
  status           String    @default("pending_review")
  items            Json      @default("[]")
  receivedDate     DateTime  @default(now())
  validUntil       DateTime?
  totalValue       Float     @default(0)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  /// The PurchaseRequest being quoted for. Quote comparison groups on this, so
  /// without it the comparison view had nothing to group and was empty for every
  /// stored quote.
  prRef            String?
  /// Where the goods should land once ordered, carried from the quote onto the
  /// purchase order.
  projectName      String?
  destinationStore String?
  storeLevel       String?

  @@index([prRef])
}

model ProjectDocument {
  id         String   @id @default(cuid())
  name       String
  type       String
  size       String   @default("")
  url        String   @default("")
  uploadedBy String
  folderName String
  projectId  String?
  tags       String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ConstructionApproval {
  id          String    @id @default(cuid())
  type        String
  reference   String
  description String
  projectId   String?
  projectName String?
  status      String    @default("Pending")
  requestedBy String
  requestDate DateTime  @default(now())
  reviewedBy  String?
  reviewedAt  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Timeline {
  id          String   @id @default(cuid())
  name        String
  projectId   String?
  projectName String?
  status      String   @default("On Track")
  startDate   DateTime
  endDate     DateTime
  phases      Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AttendanceRecord {
  id           String   @id @default(cuid())
  employeeId   String?
  employeeName String
  department   String
  date         DateTime
  clockIn      String?
  clockOut     String?
  hoursWorked  Float    @default(0)
  status       String   @default("Present")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PayrollPeriod {
  id          String       @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  status      String       @default("Open")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  payrollRuns PayrollRun[]
}

model PayrollRun {
  id                 String         @id @default(cuid())
  periodId           String?
  periodName         String
  month              Int
  year               Int
  /// HR side: "Draft" | "Processing" | "Approved". Finance side then carries it
  /// through "Pending Posting Approval" → "Posting Approved" → "Posted".
  /// Approval to post is deliberately separate from posting: the person who
  /// authorises the accounting is not always the one who runs it.
  status             String         @default("Draft")
  totalGross         Float          @default(0)
  totalNet           Float          @default(0)
  employeeCount      Int            @default(0)
  processedBy        String?
  processedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  /// Human reference shown as "Payroll Code" in the Finance Payroll Overview.
  /// Allocated from Settings → Numbering, so it follows the same convention as
  /// every other document reference rather than exposing the cuid.
  code               String?        @unique
  postingRequestedBy String?
  postingRequestedAt DateTime?
  postingApprovedBy  String?
  postingApprovedAt  DateTime?
  postedBy           String?
  postedAt           DateTime?
  /// The journal entry this run posted as, so the Overview can cite it and the
  /// General Ledger can be traced back to the run.
  journalEntryId     String?

model JournalEntry {
  id          String        @id @default(cuid())
  reference   String        @unique
  date        DateTime
  description String
  status      String        @default("Draft")
  createdBy   String
  postedAt    DateTime?
  reversedAt  DateTime?
  // Set on the reversing entry, pointing back at the entry it reverses. The
  // inverse side gives the original entry a link to its reversal, which is what
  // the Reversed badge in the UI resolves to.
  reversalOfId String?
  reversalOf   JournalEntry?  @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy   JournalEntry[] @relation("JournalReversal")

  // Where this posting came from. Every engine — Journal Entries, Payments,
  // Purchases, Payroll — posts through the same service, and these are what let
  // a General Ledger line be traced back to the thing that caused it. A hand
  // keyed entry is sourceModule "Journal" with no source record behind it.
  /// "Journal" | "Payment" | "Purchase" | "Payroll" | …
  sourceModule String  @default("Journal")
  /// The originating record's model, e.g. "PurchaseInvoice", "PayrollRun".
  sourceType   String?
  /// The originating record's id, for deep-linking back to it.
  sourceId     String?
  /// The originating document's own human reference, e.g. an invoice number.
  sourceRef    String?
  /// The configured process whose mapping produced the lines, when one did.
  process      String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  lines       JournalLine[]

  @@index([sourceModule, sourceId])
  @@index([status, date])
}


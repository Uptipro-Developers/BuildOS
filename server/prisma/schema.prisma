  approvalStatus String @default("draft") // draft|pending|approved|rejected

  // Variable-length approval trail; shape is owned by the UI.
  approvalSteps Json?

  createdBy      String
  reversalDate   DateTime?
  reversedAt     DateTime?
  reversedAmount Float?

  sourceModule String  @default("")
  sourceRef    String  @default("")
  fiscalYearId String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines AccrualLine[]

  @@index([status])
  @@index([fiscalYearId])
}


/// Per-module reference numbering (prefix, separator, zero padding, next value).
///
/// Numbering used to live only in a client-side React context, so an admin's
/// changes and every number handed out were lost on reload and two users creating
/// records at the same moment could produce the same reference. `nextNumber` is
/// incremented with an atomic UPDATE here, which is what makes a reference unique.
model NumberingConfig {
  id             String    @id @default(cuid())
  /// Logical module key, e.g. "PurchaseOrder". Matches the client's module names.
  module         String    @unique
  /// Application whose Settings page configures this module.
  app            String
  prefix         String
  separator      String    @default("-")
  padLength      Int       @default(3)
  /// The value the NEXT allocation will use.
  nextNumber     Int       @default(1)
  description    String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  /// Reference format, e.g. "PO-{N:4}". `{N:n}` is the sequence padded to n
  /// digits. This is what an admin edits; prefix/separator/padLength are kept
  /// as the pre-template representation and derived from it on save.
  template       String    @default("")
  /// First number the sequence issues.
  startingNumber Int       @default(1)
  /// Last number it may issue; null means unbounded.
  endingNumber   Int?
  /// Step between successive numbers.
  incrementBy    Int       @default(1)
  /// The last number actually issued, and when — shown in Settings so an admin
  /// can see where a sequence has reached without inferring it from `nextNumber`.
  lastUsedNumber Int       @default(0)
  lastUsedDate   DateTime?

  @@index([app])
}


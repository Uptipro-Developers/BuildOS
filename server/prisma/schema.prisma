/// The purchase order's single lifecycle, matching the implemented workflow:
/// draft → sent_to_finance → finance_accepted → paid → confirmation_requested
/// → confirmed → goods_received, with finance_declined as the one branch off it.
///
/// `sent` ("Sent to Supplier") and `partially_received` were removed: no step in
/// the workflow ever produced them, so they were labels for states the system
/// could not reach. Payment used to be tracked in a parallel POPaymentStatus
/// column, which meant an order carried two half-states and neither said whose
/// turn it was; it is one chain now.
enum POStatus {
  draft
  sent_to_finance
  finance_accepted
  finance_declined
  paid
  confirmation_requested
  confirmed
  goods_received
  cancelled
}


// ─────────────── PROCUREMENT ───────────────

model PurchaseRequest {
  id            String   @id @default(cuid())
  prRef         String   @unique
  title         String
  projectId     String?
  projectName   String?
  /// "draft" | "not_raised" | "raised" | "quotes_received" | "po_created" |
  /// "cancelled". A purchase request carries no approval status of its own —
  /// see the POStatus comment and src/app/utils/procurementWorkflow.tsx.
  status        String   @default("not_raised")
  priority      String   @default("Normal")
  requestedBy   String
  daysToDeliver Int?
  items         Json     @default("[]")
  notes         String?

  /// Reference of the MaterialRequest this was raised from, when it came through
  /// Procurement › Material Requests rather than being raised standalone. The
  /// link previously existed only inside the `notes` prose ("Raised from Material
  /// Request MR-0007"), which nothing could query or follow.
  mrRef String?

  /// How this request is being sourced: "rfq" to compete it across suppliers, or
  /// "direct" for a single named supplier. Chosen when the request is raised and
  /// it decides whether RFQs are sent, so it has to survive the round trip.
  procurementType String @default("rfq")

  /// Per-supplier progress: `{ supplier, supplierId?, status, sentDate?,
  /// quoteRef?, quoteAmount?, poRef? }`. Held as JSON rather than a table because
  /// it is only ever read back with the request it belongs to.
  suppliers Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseInvoice {
  id           String    @id @default(cuid())
  invoiceNo    String    @unique
  poRef        String?
  supplierName String
  supplierId   String?
  invoiceDate  DateTime
  dueDate      DateTime?
  lines        Json      @default("[]")
  subtotal     Float     @default(0)
  vatTotal     Float     @default(0)
  total        Float     @default(0)
  /// "pending_review" | "pending_approval" | "approved" | "rejected" | "paid" | "cancelled".
  status       String    @default("pending_review")
  /// The accounting treatment (payment date/method + GL posting lines) chosen
  /// when sending for approval. Posting reads and locks to this rather than
  /// letting it be re-decided after approval.
  postingDraft Json?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model SentRFQ {
  id           String    @id @default(cuid())
  rfqRef       String    @unique
  supplierName String
  supplierId   String?
  status       String    @default("Sent")
  items        Json      @default("[]")
  sentDate     DateTime  @default(now())
  expiryDate   DateTime?
  notes        String?

  /// The PurchaseRequest this RFQ was competed for. One row is one supplier, so
  /// an RFQ sent to five suppliers is five rows sharing a prRef — this is what
  /// groups them back into a single sourcing event for quote comparison. The UI
  /// collected it before and the server dropped it on the floor.
  prRef String?

  /// Where this RFQ was actually sent, when it differs from the supplier's
  /// filed address — a project-specific sales contact, say. Defaults to the
  /// supplier's email in the form. Stored so the list shows the address that was
  /// used and a resend goes back to the same person.
  contactEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([prRef])
}

model ReceivedQuote {
  id           String    @id @default(cuid())
  rfqRef       String?
  supplierName String
  supplierId   String?
  /// "pending_review" | "approved" | "rejected" | "po_created".
  status       String    @default("pending_review")
  items        Json      @default("[]")
  receivedDate DateTime  @default(now())
  validUntil   DateTime?
  totalValue   Float     @default(0)
  notes        String?

  /// The PurchaseRequest being quoted for. Quote comparison groups on this, so
  /// without it the comparison view had nothing to group and was empty for every
  /// stored quote.
  prRef String?

  /// Where the goods should land once ordered, carried from the quote onto the
  /// purchase order.
  projectName      String?
  destinationStore String?
  storeLevel       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([prRef])
}



// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────── ENUMS ───────────────

enum ProjectStatus {
  Active
  Planning
  OnHold
  Completed
  Cancelled
}

enum ProjectType {
  Commercial
  Residential
  Industrial
  Infrastructure
  Renovation
}

enum EmployeeStatus {
  active
  inactive
  on_leave
}

enum EmploymentType {
  FullTime
  Contract
}

enum LeaveStatus {
  pending
  approved
  rejected
}

enum TaskStatus {
  todo
  in_progress
  done
  blocked
  cancelled
}

enum TaskPriority {
  low
  medium
  high
  critical
}

enum ApprovalStatus {
  pending
  approved
  rejected
  escalated
}

enum ResourceType {
  equipment
  labor
  material
  service
}

enum DocumentType {
  contract
  invoice
  photo
  report
  specification
  other
}

enum NotificationStatus {
  sent
  read
  archived
  failed
}

/// The purchase order's single lifecycle, matching the implemented workflow:
/// draft → sent_to_finance → finance_accepted → paid → confirmation_requested
/// → confirmed → goods_received, with finance_declined as the one branch off it.
///
/// `sent` ("Sent to Supplier") and `partially_received` were removed: no step in
/// the workflow ever produced them, so they were labels for states the system
/// could not reach. Payment used to be tracked in a parallel POPaymentStatus
/// column, which meant an order carried two half-states and neither said whose
/// turn it was; it is one chain now.
enum POStatus {
  draft
  /// The wizard has been completed — term, signatories and delivery timing
  /// are saved, and the goods receipt is already open. Distinct from `draft`
  /// (a quote-accepted order the wizard hasn't touched yet) and reachable
  /// regardless of payment timing, unlike the old finance-only chain.
  po_created
  sent_to_finance
  finance_accepted
  finance_declined
  paid
  confirmation_requested
  confirmed
  goods_received
  cancelled
}

enum ExpenseStatus {
  Draft
  Submitted
  Approved
  Rejected
  SentToFinance
  Paid
}

enum IncomeStatus {
  Draft
  Confirmed
  Invoiced
  Received
}

enum BudgetScope {
  Project
  Department
}

enum BudgetStatus {
  Active
  OnTrack
  AtRisk
  OverBudget
  Closed
}

enum PaymentType {
  Expense
  Payroll
  Vendor
  Contractor
}

enum PaymentStatus {
  ApprovedRequest
  SentToFinance
  PaymentInitiated
  PaymentCompleted
  Failed
}

enum ClaimStatus {
  Submitted
  UnderReview
  Approved
  Rejected
  Paid
}

// ─────────────── PROJECTS ───────────────

model Project {
  id             String        @id @default(cuid())
  name           String
  client         String
  location       String
  state          String
  city           String
  status         ProjectStatus @default(Planning)
  type           ProjectType
  budget         Float
  spent          Float         @default(0)
  contingency    Float?        @default(0)
  progress       Int           @default(0)
  startDate      DateTime
  endDate        DateTime
  actualEndDate  DateTime?
  manager        String
  teamSize       Int           @default(0)
  approvalStatus String        @default("pending") // pending, approved, rejected
  stakeholders   String[]      @default([])

  // ─── Construction-module fields ───
  // Full-fidelity storage for the richer construction `Project` shape. All
  // nullable so the core ERP project shape and existing rows are unaffected;
  // the construction read/write mappers (src/app/api/projects.ts) round-trip
  // these alongside the shared columns (name, client, budget, manager, dates).
  siteAddress      String?
  mainContractor   String?
  mainContractorId String?
  contractType     String? // Lump Sum | Remeasurable | Cost Plus
  clusterId        String?
  ragStatus        String?   @default("on-track") // on-track | at-risk | delayed
  description      String?
  descriptor       String?
  sector           String?
  category         String?
  blockCount       Int?
  contractingModel String? // developer | contractor | gc
  lastReportDate   DateTime?
  setupComplete    Boolean?  @default(false)
  setupProgress    Int?      @default(0)
  setupLocked      Boolean?  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]
  incomes  Income[]
  budgets  Budget[]
}

// ─────────────── DEPARTMENTS ───────────────

model Department {
  id              String    @id @default(cuid())
  name            String    @unique
  description     String
  location        String
  budget          Float     @default(0)
  budgetStartDate DateTime?
  budgetEndDate   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  head      Employee?  @relation("DeptHead", fields: [headId], references: [id])
  headId    String?    @unique
  employees Employee[] @relation("DeptMembers")
}

// ─────────────── EMPLOYEES ───────────────

model Employee {
  id             String         @id @default(cuid())
  firstName      String
  lastName       String
  middleName     String?
  email          String         @unique
  phone          String
  dateOfBirth    DateTime?
  gender         String?
  dateHired      DateTime
  status         EmployeeStatus @default(active)
  employmentType EmploymentType @default(FullTime)
  projectCount   Int            @default(0)
  projects       String[]       @default([])

  // Salary/Grade fields
  baseSalary Float?   @default(0)
  gradeLevel String?
  jobRoleId  String?
  jobRole    JobRole? @relation("EmployeeJobRole", fields: [jobRoleId], references: [id])

  // Bank details (for payroll)
  bankName      String?
  accountNumber String?
  accountHolder String?

  // Supervisor relationship
  supervisorId String?
  supervisor   Employee?  @relation("SupervisorOf", fields: [supervisorId], references: [id])
  subordinates Employee[] @relation("SupervisorOf")

  // Tax/Compliance
  taxId             String?
  pensionId         String?
  healthInsuranceId String?

  // Job role (free-text position title, separate from the jobRole relation)
  role String?

  // Additional info
  emergencyContact String?
  emergencyPhone   String?
  address          String?
  city             String?
  state            String?
  zipCode          String?

  /// Captured by the Add/Edit Employee form in the design. These had no columns,
  /// so the values were collected and silently dropped on save.
  maritalStatus String?
  nationality   String?
  orgUnit       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department   Department? @relation("DeptMembers", fields: [departmentId], references: [id])
  departmentId String?

  // Linked login account, created automatically when the employee is onboarded
  user   User?   @relation(fields: [userId], references: [id])
  userId String? @unique

  headOf        Department?    @relation("DeptHead")
  leaveRequests LeaveRequest[]
  claims        Claim[]
}

// ─────────────── LEAVE TYPES ───────────────

model LeaveType {
  id                String   @id @default(cuid())
  name              String   @unique
  daysAllowed       Int
  carryOver         Boolean  @default(false)
  maxCarryOver      Int      @default(0)
  paid              Boolean  @default(true)
  approvalsRequired Int      @default(1)
  color             String
  gender            String   @default("All")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  leaveRequests LeaveRequest[]
}

// ─────────────── LEAVE REQUESTS ───────────────

model LeaveRequest {
  id          String      @id @default(cuid())
  refId       String      @unique
  days        Int
  startDate   DateTime
  endDate     DateTime
  status      LeaveStatus @default(pending)
  submittedAt DateTime    @default(now())
  approvedBy  String?
  approvedAt  DateTime?
  notes       String?

  // Balance tracking for audit
  balanceBefore Int?
  balanceAfter  Int?
  autoApproved  Boolean? @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee    Employee  @relation(fields: [employeeId], references: [id])
  employeeId  String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  leaveTypeId String
}

// ─────────────── CLAIM TYPES ───────────────

model ClaimType {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String
  isProjectBased Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  claims Claim[]
}

// ─────────────── CLAIMS ───────────────

model Claim {
  id              String      @id @default(cuid())
  amount          Float
  description     String
  date            DateTime
  status          ClaimStatus @default(Submitted)
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  paidAt          DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  employee    Employee  @relation(fields: [employeeId], references: [id])
  employeeId  String
  claimType   ClaimType @relation(fields: [claimTypeId], references: [id])
  claimTypeId String
}

// ─────────────── SUPPLIERS ───────────────

model Supplier {
  id                 String    @id @default(cuid())
  name               String
  contactPerson      String
  phone              String
  email              String
  city               String
  categories         String[]
  rating             Float     @default(0)
  onTimeDeliveryRate Float     @default(0)
  rejectRate         Float     @default(0)
  totalSpend         Float     @default(0)
  lastOrder          DateTime?
  status             String    @default("active")
  notes              String?

  /// Identity bridge to the SabiQuot supplier portal. Holds the SabiQuot
  /// `profiles.id` (a uuid) for suppliers that exist on both sides, so an RFQ
  /// can be routed to the right portal account and a portal signup can be
  /// reconciled against an existing supplier instead of duplicating it.
  sabiquotProfileId String? @unique

  /// Where this supplier record originated: "buildos" for records created in
  /// the ERP, "sabiquot" for portal self-registrations.
  source String @default("buildos")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materials      SupplierMaterial[]
  purchaseOrders PurchaseOrder[]
}

model SupplierMaterial {
  id         String   @id @default(cuid())
  name       String
  unit       String
  lastPrice  Float
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId String
}

// ─────────────── PURCHASE ORDERS ───────────────

model PurchaseOrder {
  id String @id @default(cuid())

  /// The order's own human reference (PO-0007), from the PurchaseOrder sequence
  /// in Settings › Numbering. The award screen allocated one and then threw it
  /// away because there was no column for it, so every screen fell back to
  /// showing the cuid under a heading that said "PO ID" — and a goods receipt
  /// could not cite the order it was receiving against.
  poRef String? @unique

  prRef String?
  mrRef String?

  /// The ReceivedQuote that was awarded, when this order came out of a quote
  /// comparison. This is the record of *which* supplier won and at what price,
  /// and there was previously nowhere to put it — so an award could not be
  /// represented even though the UI offered the button.
  quoteRef String?

  status        POStatus @default(draft)
  sentToFinance Boolean  @default(false)

  /// Snapshot of the payment term picked in the wizard — not a live FK, since
  /// Settings can edit or delete a term later and this order should keep what
  /// was true when it was raised. `deliverySplit` is what a post-delivery
  /// order's goods receipt checks to decide whether it should raise Finance's
  /// invoice itself once fully received (see GoodsReceiptsService.receive).
  paymentTermId String?
  deliverySplit String?

  /// Snapshot of the signatories picked in the wizard — `[{id, name, role}]`.
  /// A Signatory record can be edited or removed later; the PO's own printed
  /// document (and the file-icon re-preview) should keep showing who actually
  /// signed it at creation time, not whoever is on file now.
  signatories Json @default("[]")

  /// Full snapshot of the term picked in the wizard — `{name, description,
  /// deliverySplit, tranches}`. `paymentTermId`/`deliverySplit` above cover
  /// workflow gating; this is what the file-icon re-preview renders, since a
  /// custom term (built ad hoc in the wizard) has no real row to look back
  /// up, and a saved one could be edited or deleted after the fact.
  paymentTermSnapshot Json @default("{}")

  /// Invoice number of the PurchaseInvoice raised in Finance when this order was
  /// sent there. The link is what lets a payment recorded in Finance show up on
  /// the order in Procurement.
  financeRef String?

  createdBy     String
  createdDate   DateTime @default(now())
  expectedDate  DateTime
  totalValue    Float    @default(0)
  receivedValue Float    @default(0)

  /// Milestones of the payment chain, so the order can say *when* each step
  /// happened rather than only which step it is on.
  sentToFinanceAt DateTime?
  financeDecidedAt DateTime?
  paidAt          DateTime?
  confirmedAt     DateTime?

  /// Why Finance declined, shown back on the order in Procurement so the buyer
  /// knows what to fix.
  declineReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  supplierId    String
  items         POItem[]
  goodsReceipts GoodsReceipt[]
}

model POItem {
  id              String        @id @default(cuid())
  material        String
  qty             Float
  unit            String
  unitCost        Float
  received        Float         @default(0)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String
}

/// A delivery received against a purchase order.
///
/// Goods Receipt was previously a screen with no storage behind it at all: the
/// list started empty on every load, "Accept & Update Stock" flipped a flag in
/// React state, and nothing reached stock, materials or the storefront. This is
/// the record that closes the chain — receiving one updates StockMovement,
/// StoreItem and Material, and moves the order to `goods_received`.
model GoodsReceipt {
  id        String @id @default(cuid())
  reference String @unique

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  /// Denormalised so a receipt still reads correctly in lists and exports
  /// without joining the order.
  poRef        String?
  mrRef        String?
  supplierName String

  /// Where the goods landed. Stock is posted against this store.
  storeId   String?
  storeName String

  deliveryNote String?
  receivedBy   String
  receivedDate DateTime @default(now())
  /// "pending" | "pending_approval" | "partial_delivery" | "over_supply" |
  /// "under_supply" | "fully_received" | "rejected".
  status       String   @default("pending")
  notes        String?

  /// Set the first time the receipt is accepted and stock has been posted —
  /// and updated again on each further accepted pass ("Record Remaining
  /// Delivery"). Guards each pass so a double-click cannot post it twice.
  stockPostedAt DateTime?

  items GoodsReceiptItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseOrderId])
}

model GoodsReceiptItem {
  id       String @id @default(cuid())
  material String
  unit     String
  ordered  Float  @default(0)
  /// Cumulative totals across every *accepted* pass — only "Accept & Update
  /// Stock" moves these. A delivery still awaiting a decision lives in the
  /// pending* fields below instead, so editing or rejecting it cannot corrupt
  /// figures already posted to stock.
  received Float  @default(0)
  accepted Float  @default(0)
  rejected Float  @default(0)
  reason   String?

  /// This pass's not-yet-decided quantities, keyed in by Update Record /
  /// Record Remaining Delivery and overwritten by Edit Record. Folded into
  /// the cumulative totals above (and cleared) the moment the record is
  /// accepted.
  pendingReceived Float?
  pendingAccepted Float?
  pendingRejected Float?
  pendingReason   String?

  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  goodsReceiptId String
}

// ─────────────── EXPENSES ───────────────

model Expense {
  id              String        @id @default(cuid())
  category        String
  amount          Float
  description     String
  createdBy       String
  date            DateTime
  status          ExpenseStatus @default(Draft)
  receipt         String?
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?
}

// ─────────────── INCOME ───────────────

model Income {
  id          String       @id @default(cuid())
  source      String
  amount      Float
  description String
  date        DateTime
  status      IncomeStatus @default(Draft)
  receivedBy  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?
}

// ─────────────── BUDGETS ───────────────

model Budget {
  id          String       @id @default(cuid())
  name        String
  scope       BudgetScope  @default(Project)
  totalBudget Float
  spent       Float        @default(0)
  committed   Float        @default(0)
  period      String
  status      BudgetStatus @default(Active)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?
}

// ─────────────── PAYMENTS ───────────────

model Payment {
  id          String        @id @default(cuid())
  type        PaymentType
  reference   String
  recipient   String
  amount      Float
  method      String
  bank        String?
  date        DateTime
  status      PaymentStatus @default(ApprovedRequest)
  initiatedBy String?
  completedAt DateTime?
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// ─────────────── USERS ───────────────

model User {
  id        String  @id @default(cuid())
  userId    String? @unique
  email     String  @unique
  password  String
  name      String
  phone     String?
  signature String?
  status    String  @default("Active")

  // Multi-role support
  assignedApps    String[] @default(["ess"])
  department      String?
  permissionScope String   @default("global") // "global" | "departmental" | "project"

  // Per-user permission extensions granted on Admin → Users → Edit User, on top
  // of whatever the assigned role already grants. Same encoding as
  // AppRole.inheritedRoles ("proc:<processId>:<action>" / "nav:<navId>") so the
  // role and user layers decode through one shared helper.
  permissionOverrides String[] @default([])

  // Old single role (deprecated, kept for backward compat)
  role String @default("viewer")

  // Last login tracking
  lastLogin             DateTime?

  /// Last time an authenticated request was seen from this user, refreshed as
  /// they use the app rather than only at login. `lastLogin` cannot answer "who
  /// is logged in now" — somebody who signed in this morning and left still
  /// counts against it all day.
  lastSeenAt DateTime?
  inviteToken           String?
  inviteExpiresAt       DateTime?
  refreshTokenHash      String?
  refreshTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  roles           UserRole[]
  permissions     Permission[]
  auditLogs       AuditLog[]
  passwordHistory UserPasswordHistory[]
  employee        Employee?
  signatories     Signatory[]

  /// The Active Sessions metric counts by this on every dashboard load.
  @@index([lastSeenAt])
}

model UserRole {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  role       AppRole   @relation(fields: [roleId], references: [id])
  roleId     String
  validFrom  DateTime  @default(now())
  validUntil DateTime?
  grantedBy  String?
  createdAt  DateTime  @default(now())

  @@unique([userId, roleId])
}

model Permission {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  appScope    String // "admin" | "hr" | "projects" | "finance" | "procurement" | "ess"
  users       User[]
  appRoles    AppRole[]
  createdAt   DateTime  @default(now())
}

// ─────────────── APP ROLES / PERMISSIONS ───────────────

model AppRole {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isSuper     Boolean @default(false)

  // App scope
  appScope String[] @default([])

  // Role hierarchy
  inheritedRoles String[] @default([])

  permissions Permission[]
  users       UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A person authorised to sign a Purchase Order, configured in Procurement
/// Settings › Signatories. Department and role are captured at the time they
/// are added rather than read live off the User record, so a later change to
/// someone's own department or role doesn't silently rewrite a signatory list
/// that was deliberately set up a certain way.
model Signatory {
  id         String @id @default(cuid())
  department String
  role       String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// One record per person: re-adding an existing signatory is an edit (their
  /// department/role snapshot changes), not a second row that makes the same
  /// person appear twice in a PO's signature block.
  userId     String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A payment term a Purchase Order's Create-PO wizard can pick from,
/// configured in Procurement Settings › Payment Terms. `tranches` is a JSON
/// array (`{ title, percent, timing }[]`) rather than a child table — like
/// PurchaseRequest.items and SentRFQ.items elsewhere in this schema, it is
/// only ever read back together with the row it belongs to. `deliverySplit`
/// is chosen independently in the modal, not derived from the tranches.
model PaymentTerm {
  id            String  @id @default(cuid())
  name          String
  description   String  @default("")
  /// "pre_delivery" | "post_delivery"
  deliverySplit String
  tranches      Json    @default("[]")
  /// Exactly one row may carry this at a time — enforced in the service, not
  /// the schema, the same way it isn't a DB constraint anywhere else in this
  /// codebase either.
  isDefault     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────── COMPANY PROFILE / DIRECTORS ───────────────

model CompanyProfile {
  id        String   @id @default("singleton")
  name      String   @default("")
  email     String   @default("")
  phone     String   @default("")
  address   String   @default("")
  city      String   @default("")
  state     String   @default("")
  zipCode   String   @default("")
  country   String   @default("")
  logoUrl   String?
  updatedAt DateTime @updatedAt
}

model Director {
  id          String   @id @default(cuid())
  firstName   String
  middleName  String   @default("")
  lastName    String
  designation String
  sequence    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────── MATERIALS / INVENTORY ───────────────

/// Category → Material → Type. A Material (e.g. "Cement (50kg bag)") is the
/// catalog-facing row and also where actual stock has always lived.
/// Material's totalQty/availableQty/reservedQty/unitCost are a rollup summed
/// (unitCost: quantity-weighted average) across its Types whenever a Type
/// is added/edited from the catalog.
model Material {
  id               String   @id @default(cuid())
  name             String
  category         String
  /// Denormalised from MaterialCategory.name when created via the catalog —
  /// legacy rows created directly by Goods Receipt predate categoryId and
  /// have none.
  categoryId       String?
  materialCategory MaterialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Optional — legacy Goods-Receipt-created rows always set this; catalog-
  /// created rows source it from the dimension that produced the row.
  unit             String?
  /// Catalog-created rows only. Kind/value are the dimension that produced
  /// this row (e.g. { kind: "Length", value: 12, unit: "mm" }) — one row per
  /// dimension, no separate Type table underneath any more.
  sku              String?
  kind             String?
  value            Float?
  totalQty         Float    @default(0)
  availableQty     Float    @default(0)
  reservedQty      Float    @default(0)
  unitCost         Float    @default(0)
  reorderLevel     Float    @default(0)
  /// "Consumable" | "Reusable"
  materialType     String   @default("Consumable")
  allocationStatus String   @default("Available")
  allocatedTo      String?
  allocatedProject String?
  condition        String?
  /// Catalog-created rows only — the Material Name/item name entered in the
  /// Storefront Config builder, before they and the dimension were
  /// concatenated into `name`. Lets the builder regroup its flat rows back
  /// into a Material -> item -> dimension tree when a category is reopened
  /// for edit; not shown anywhere as its own field.
  materialGroupName String?
  itemName          String?
  /// Which store this material is attached to — optional, set from the Edit
  /// Material modal on the All Materials page. storeName is denormalised the
  /// same way category/categoryId are, for display without a join.
  storeId          String?
  store            Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  storeName        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([categoryId])
  @@index([storeId])
}

model MaterialCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("teal")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


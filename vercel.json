{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "github": {
    "silent": true
  },
  "regions": [
    "fra1"
  ],
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}